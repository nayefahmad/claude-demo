# City settings
CITY=San Francisco
CITY_LAT=37.7749
CITY_LON=-122.4194
COUNTRY_CODE=US

# Email (SMTP) — leave blank to use dev mode (prints to stdout)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your@gmail.com
EMAIL_TO=recipient@example.com

# Event source APIs (optional — mock data used if absent)
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=

# Claude API (optional — used for enhanced recommendations)
ANTHROPIC_API_KEY=

# App settings
DB_PATH=city_events.db
FEEDBACK_BASE_URL=http://localhost:5000
API_PORT=5000
WEEKLY_DAY=monday
WEEKLY_HOUR=9
MAX_RECOMMENDATIONS=10
LOG_LEVEL=INFO
